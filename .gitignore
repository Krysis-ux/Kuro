# Rust
/target/
**/*.rs.bk

# Packaging output: an assembled app bundle and the disk image built from it.
# Both are reproducible from packaging/macos/build-dmg.sh, and the image is
# hundreds of megabytes.
/build/
/dist/

# Frontend
web/node_modules/
web/dist/
web/.vite/
*.tsbuildinfo

# Kuro runtime data never belongs in the repo: it holds the local database,
# multi-gigabyte model weights and the downloaded engine binaries.
.kuro/
kuro.sqlite3*

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs and scratch
*.log
/tmp/

# The credential store. Never committed — it holds provider API keys and MCP
# bearer tokens in plain text, deliberately outside the database.
credentials.json
